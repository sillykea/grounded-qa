{
  "listen": ":8080",
  "api_keys": [{ "name": "grounded-qa", "key_env": "GATEWAY_API_KEY", "rpm": 600, "monthly_budget_usd": 0 }],
  "providers": [
    { "name": "ollama", "type": "ollama", "base_url": "http://ollama:11434", "local": true, "timeout_seconds": 300 }
